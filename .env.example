# Copiar a .env para correr los scripts en tu máquina (no subir el .env real).
# En GitHub Actions, estas mismas variables van como "Secrets" del repo
# (Settings -> Secrets and variables -> Actions), no como archivo.

APIFY_TOKEN=
DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_db

# Resend: una cuenta por dominio. La interna manda los avisos al equipo; la de
# prospectos es para escribirle a los leads (todavía no se usa para enviar).
RESEND_API_KEY=
RESEND_API_KEY_PROSPECTOS=

# «Mejorar texto» con IA en la pestaña Análisis de marca (opcional). Se carga como
# variable del servicio del panel en Railway. Sin IA_API_KEY el botón queda apagado.
# Sirve cualquier proveedor con formato «chat completions» de OpenAI.
IA_API_KEY=
# Por defecto Groq: https://api.groq.com/openai/v1  (OpenRouter: https://openrouter.ai/api/v1)
IA_API_URL=
# Por defecto llama-3.3-70b-versatile (Llama de código abierto)
IA_MODEL=

# Calendario (Google Calendar), solo en el servicio del panel en Railway. Cuenta de
# servicio de Google Cloud con la Calendar API habilitada; el calendario se comparte con
# su mail (permiso «Hacer cambios en eventos»). Sin estas dos el panel anda igual y la
# pantalla Calendario muestra la guía de configuración.
# El contenido COMPLETO del archivo JSON de la clave (una sola línea o con saltos):
GOOGLE_SERVICE_ACCOUNT_JSON=
# El calendario principal usa el mail de la cuenta como id (smartiesconsultora@gmail.com):
GOOGLE_CALENDAR_ID=

# Para que el panel genere links de Meet y el mail de aviso al agendar hace falta conectar la
# propia cuenta de Google del estudio (OAuth; la cuenta de servicio no puede). Con estas tres
# variables se usan en lugar de la cuenta de servicio. El token sale del botón «Conectar con
# Google» de la pantalla Calendario (lo ve un administrador una sola vez).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Opcional: a dónde llega la copia de cada aviso de «agendamos» (por defecto, el mail del calendario).
CALENDARIO_AVISO_EQUIPO=
