# Copiar a .env para correr los scripts en tu máquina (no subir el .env real).
# En GitHub Actions, estas mismas variables van como "Secrets" del repo
# (Settings -> Secrets and variables -> Actions), no como archivo.

APIFY_TOKEN=
DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_db

# Resend: una cuenta por dominio. La interna manda los avisos al equipo; la de
# prospectos es para escribirle a los leads (todavía no se usa para enviar).
RESEND_API_KEY=
RESEND_API_KEY_PROSPECTOS=
